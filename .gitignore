# Node
node_modules/
*.log

# 覆盖率报告与工具缓存（vitest 默认 reportsDirectory=coverage）
coverage/

# WebView2 / runtime data
*.WebView2/
EBWebView/
Local Storage/
Session Storage/
GPUCache/
Code Cache/

# 启动器临时工作区
sandbox/.sandbox/
launcher-workspace/

# 安装程序内置运行时负载（node/pnpm 压缩包，体积大，由 download-runtime.ps1 生成，随分发包发布但不进 git）
installer/runtime/

# 系统/编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 构建输出（如需上传 release 请保留）
# release/*.exe

# 本地开发备份（Git 历史已具备版本管理，备份不进仓库）
uninstaller/**/backups/
uninstaller/**/build/

# 启动器自动生成的索引（勿提交）
assembly/*/resolvedAssembly.json

# 内部审查/规划文档（本地工作产物，不入库）
/AI*.md

# 跨平台发布包构建输出（GitHub Release 资产，不提交仓库）
release/dist/
